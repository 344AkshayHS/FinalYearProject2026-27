# Copy this file to .env

# Address of the GreenRoot backend.
# Leave it empty while developing: the app then uses the same PC that runs `npx expo start`
# (found from the Expo dev server), so it keeps working when the PC's Wi-Fi address changes.
# Set it only for a built APK, or when the backend runs on another PC - your PC's Wi-Fi IPv4
# address from `ipconfig`, with port 4000:
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
EXPO_PUBLIC_API_URL=
