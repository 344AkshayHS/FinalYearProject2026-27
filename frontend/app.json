{
  "expo": {
    "name": "GreenRoot",
    "slug": "sololvl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "greenroot",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.sololvls.greenroot",
      "adaptiveIcon": {
        "backgroundColor": "#2E7D32",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2E7D32",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "GreenRoot uses a photo you choose as your profile picture.",
          "cameraPermission": "GreenRoot uses the camera only when you take a profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GreenRoot uses your location to read the soil and climate of your field."
        }
      ],
      "./plugins/allow-local-http"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c45da649-4093-4f67-a774-8bbf771a094b"
      }
    },
    "owner": "sololvls-team"
  }
}
