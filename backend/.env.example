# Copy this file to .env and fill in your values

PORT=4000

# The website (web/). Only needed when it is opened at another address than http://localhost:5173
# (or http://localhost:4000 once built): the addresses it is opened at, separated by commas.
# Requests that use the website's login cookie are refused if they come from anywhere else.
# WEB_ORIGIN=https://greenroot.example.com

# Set to true when the website is served over https, so the login cookie is never sent over plain http
# COOKIE_SECURE=true

# Set to 1 when the backend runs behind a reverse proxy (nginx, a host's load balancer), so the
# request limits count each person's own address
# TRUST_PROXY=1

# PostgreSQL: your postgres password and port (5432 is the default)
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/greenroot

# Python ML service
ML_SERVICE_URL=http://localhost:8000

# Optional: AI for the crop helper chat, asked only when the app's own checked answers cannot answer.
# Tried in this order: Groq (free key from console.groq.com), then Gemini (free key from aistudio.google.com).
# Leave both empty and the chat uses its rule-based answers only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
