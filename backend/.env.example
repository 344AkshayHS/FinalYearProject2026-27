# Copy this file to .env and fill in your values

PORT=4000

# PostgreSQL: your postgres password and port (5432 is the default)
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/greenroot

# Python ML service
ML_SERVICE_URL=http://localhost:8000

# Optional: Gemini LLM for the crop helper chat (free key from aistudio.google.com).
# Leave empty and the chat uses its rule-based answers only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
